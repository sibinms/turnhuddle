{
  "name": "turnhuddle",
  "displayName": "Turnhuddle",
  "description": "Claude Code, Codex and Gemini in one VS Code chat: pick any agent and model to draft, another to review, and they keep going until both agree.",
  "version": "0.3.0",
  "publisher": "turnhuddle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sibinms/turnhuddle.git"
  },
  "homepage": "https://github.com/sibinms/turnhuddle#readme",
  "bugs": {
    "url": "https://github.com/sibinms/turnhuddle/issues"
  },
  "icon": "media/icon.png",
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "claude",
    "codex",
    "gemini",
    "ai",
    "agents",
    "models",
    "code review",
    "chat",
    "pair programming"
  ],
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "turnhuddle.check",
        "title": "Check CLI Installations",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.start",
        "title": "Start Conversation",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.reply",
        "title": "Reply in Conversation",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.cancel",
        "title": "Cancel Conversation",
        "category": "Turnhuddle",
        "icon": "$(debug-stop)"
      },
      {
        "command": "turnhuddle.clear",
        "title": "New Thread",
        "category": "Turnhuddle",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "turnhuddle.getState",
        "title": "Get Conversation State",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.open",
        "title": "Open Conversation",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.archive",
        "title": "Archive Thread",
        "category": "Turnhuddle",
        "icon": "$(archive)"
      },
      {
        "command": "turnhuddle.restore",
        "title": "Restore Thread",
        "category": "Turnhuddle",
        "icon": "$(history)"
      },
      {
        "command": "turnhuddle.revealHistory",
        "title": "Reveal History Folder",
        "category": "Turnhuddle",
        "icon": "$(folder-opened)"
      },
      {
        "command": "turnhuddle.listSessions",
        "title": "List Conversations",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.refreshSessions",
        "title": "Refresh Conversations",
        "category": "Turnhuddle",
        "icon": "$(refresh)"
      },
      {
        "command": "turnhuddle.continueFrom",
        "title": "Continue from a Claude Code or Codex Session",
        "category": "Turnhuddle",
        "icon": "$(debug-continue)"
      },
      {
        "command": "turnhuddle.listVendorSessions",
        "title": "List CLI Sessions",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.checkForUpdates",
        "title": "Check for Updates",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.history",
        "title": "Conversation History",
        "category": "Turnhuddle",
        "icon": "$(history)"
      },
      {
        "command": "turnhuddle.toggleBookmark",
        "title": "Bookmark Conversation",
        "category": "Turnhuddle",
        "icon": "$(bookmark)"
      },
      {
        "command": "turnhuddle.rename",
        "title": "Rename Thread",
        "category": "Turnhuddle",
        "icon": "$(edit)"
      },
      {
        "command": "turnhuddle.pickDrafter",
        "title": "Choose the Drafter's Agent and Model",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.pickReviewer",
        "title": "Choose the Reviewer's Agent and Model",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.swapSeats",
        "title": "Swap Drafter and Reviewer",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.pickAgent",
        "title": "Choose Agent and Model",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.focus",
        "title": "Open Chat",
        "category": "Turnhuddle",
        "icon": {
          "light": "media/turnhuddle.svg",
          "dark": "media/turnhuddle.svg"
        }
      },
      {
        "command": "turnhuddle.newThread",
        "title": "New Thread",
        "category": "Turnhuddle",
        "icon": "$(add)"
      },
      {
        "command": "turnhuddle.unbookmark",
        "title": "Remove Bookmark",
        "category": "Turnhuddle",
        "icon": "$(bookmark)"
      },
      {
        "command": "turnhuddle.toggleArchived",
        "title": "Show or Hide Archived Threads",
        "category": "Turnhuddle",
        "icon": "$(archive)"
      },
      {
        "command": "turnhuddle.steer",
        "title": "Send to the Running Turn",
        "category": "Turnhuddle"
      }
    ],
    "configuration": {
      "title": "Turnhuddle",
      "properties": {
        "turnhuddle.drafter": {
          "type": "string",
          "default": "claude",
          "order": 0,
          "markdownDescription": "Who drafts in new conversations: proposes an approach and revises it. `provider` or `provider:model`, e.g. `claude`, `claude:opus`, `codex:gpt-6.2-sol`, `gemini:gemini-2.5-pro`. Providers: `claude` (Claude Code), `codex` (Codex), `gemini` (Gemini CLI, preview). Easier: click the drafter's name under the chat's message box."
        },
        "turnhuddle.reviewer": {
          "type": "string",
          "default": "codex",
          "order": 1,
          "markdownDescription": "Who reviews in new conversations: critiques the drafter until both agree. Same format as `#turnhuddle.drafter#`. The same provider may take both seats, for example with two different models."
        },
        "turnhuddle.claudePath": {
          "type": "string",
          "default": "claude",
          "scope": "machine",
          "description": "Claude Code CLI executable. Leave as \"claude\" to find it automatically: on PATH, in common install folders, in your login shell's PATH, or bundled with the Claude Code VS Code extension. Set a full path to override."
        },
        "turnhuddle.codexPath": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "description": "Codex CLI executable. Leave as \"codex\" to find it automatically: on PATH, in common install folders, in your login shell's PATH, or bundled with the Codex (OpenAI) VS Code extension. Set a full path to override."
        },
        "turnhuddle.geminiPath": {
          "type": "string",
          "default": "gemini",
          "markdownDescription": "Gemini CLI executable (preview support). Leave as `gemini` to find it on PATH, in common install folders or in your login shell's PATH. Set a full path to override. Install: https://github.com/google-gemini/gemini-cli"
        },
        "turnhuddle.timeoutSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 1,
          "maximum": 1800
        },
        "turnhuddle.maxOutputBytes": {
          "type": "number",
          "default": 1048576,
          "minimum": 1024,
          "maximum": 10485760,
          "description": "Largest reply, in bytes, accepted from one agent turn. The CLIs' streamed tool output (files read, search results) isn't counted; a separate 64 MB cap stops a runaway process."
        },
        "turnhuddle.claudeEffort": {
          "type": "string",
          "enum": [
            "inherit",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "inherit",
          "description": "Effort level passed to the Claude CLI (--effort). \"inherit\" uses the CLI's own default."
        },
        "turnhuddle.codexReasoningEffort": {
          "type": "string",
          "enum": [
            "inherit",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "ultra"
          ],
          "default": "medium",
          "description": "Reasoning effort for the Codex CLI (model_reasoning_effort) during Turnhuddle turns only. \"inherit\" uses your Codex config; \"ultra\" and \"xhigh\" take the longest."
        },
        "turnhuddle.roundMode": {
          "type": "string",
          "enum": [
            "agreement",
            "fixed"
          ],
          "enumDescriptions": [
            "Claude and Codex alternate until both end a turn with VERDICT: AGREE back to back, or the turn limit is reached.",
            "Three turns per round: Claude proposes, Codex reviews, Claude replies."
          ],
          "default": "agreement",
          "description": "How a round ends."
        },
        "turnhuddle.maxTurnsPerRound": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "maximum": 30,
          "description": "Agreement mode: the most agent turns in one round before it ends without agreement."
        },
        "turnhuddle.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Check GitHub once a day for a newer Turnhuddle release and offer to install it. Installs from the Marketplace are also updated by VS Code itself."
        },
        "turnhuddle.vendorLogos": {
          "type": "boolean",
          "default": true,
          "description": "Show the Claude and Codex logos next to their messages, read from the Claude Code and Codex VS Code extensions installed on this machine (Turnhuddle doesn't bundle them). Off, or when those extensions aren't installed: initials are shown."
        },
        "turnhuddle.showEditorButton": {
          "type": "boolean",
          "default": true,
          "description": "Show the Turnhuddle button in the editor title bar, to open the chat."
        },
        "turnhuddle.keepAgentSessions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Each seat keeps its own Claude Code or Codex session for the whole thread: later turns resume it (`claude --resume`, `codex exec resume`) and send only the new messages, instead of replaying the whole conversation every turn. Faster and cheaper on long threads. Turn off to replay every turn."
        },
        "turnhuddle.engine": {
          "type": "string",
          "enum": [
            "live",
            "cli"
          ],
          "default": "live",
          "enumDescriptions": [
            "One long-lived agent per thread and seat, like T3 Code: Codex through `codex app-server`, Claude through the Claude Agent SDK (pointed at your own `claude`), Gemini through ACP. Streams, can be steered and stopped mid-turn.",
            "A CLI process per turn (`claude -p`, `codex exec`), resuming each seat's session when `turnhuddle.keepAgentSessions` is on."
          ],
          "markdownDescription": "How Turnhuddle talks to the agents."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "turnhuddle-threads",
          "title": "Turnhuddle",
          "icon": "media/turnhuddle.svg"
        },
        {
          "id": "turnhuddle-chat",
          "title": "Turnhuddle Chat",
          "icon": "media/turnhuddle.svg",
          "when": "turnhuddle.noSecondarySidebar"
        }
      ],
      "secondarySidebar": [
        {
          "id": "turnhuddle-chat-secondary",
          "title": "Turnhuddle",
          "icon": "media/turnhuddle.svg",
          "when": "!turnhuddle.noSecondarySidebar"
        }
      ]
    },
    "views": {
      "turnhuddle-threads": [
        {
          "type": "tree",
          "id": "turnhuddle.threads",
          "name": "Threads",
          "contextualTitle": "Turnhuddle"
        }
      ],
      "turnhuddle-chat": [
        {
          "type": "webview",
          "id": "turnhuddle.chat",
          "name": "Turnhuddle Chat",
          "when": "turnhuddle.noSecondarySidebar"
        }
      ],
      "turnhuddle-chat-secondary": [
        {
          "type": "webview",
          "id": "turnhuddle.chatSecondary",
          "name": "Turnhuddle",
          "when": "!turnhuddle.noSecondarySidebar"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "turnhuddle.newThread",
          "when": "view == turnhuddle.threads",
          "group": "navigation@1"
        },
        {
          "command": "turnhuddle.continueFrom",
          "when": "view == turnhuddle.threads",
          "group": "navigation@2"
        },
        {
          "command": "turnhuddle.toggleArchived",
          "when": "view == turnhuddle.threads",
          "group": "navigation@3"
        },
        {
          "command": "turnhuddle.revealHistory",
          "when": "view == turnhuddle.threads",
          "group": "z_more@1"
        }
      ],
      "commandPalette": [
        {
          "command": "turnhuddle.getState",
          "when": "false"
        },
        {
          "command": "turnhuddle.listSessions",
          "when": "false"
        },
        {
          "command": "turnhuddle.open",
          "when": "false"
        },
        {
          "command": "turnhuddle.archive",
          "when": "false"
        },
        {
          "command": "turnhuddle.restore",
          "when": "false"
        },
        {
          "command": "turnhuddle.refreshSessions",
          "when": "false"
        },
        {
          "command": "turnhuddle.listVendorSessions",
          "when": "false"
        },
        {
          "command": "turnhuddle.pickAgent",
          "when": "false"
        },
        {
          "command": "turnhuddle.unbookmark",
          "when": "false"
        },
        {
          "command": "turnhuddle.toggleArchived",
          "when": "false"
        },
        {
          "command": "turnhuddle.steer",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "turnhuddle.toggleBookmark",
          "when": "view == turnhuddle.threads && viewItem =~ /^thread-live(?!.*bookmarked)/",
          "group": "inline@1"
        },
        {
          "command": "turnhuddle.unbookmark",
          "when": "view == turnhuddle.threads && viewItem =~ /bookmarked/",
          "group": "inline@1"
        },
        {
          "command": "turnhuddle.archive",
          "when": "view == turnhuddle.threads && viewItem =~ /^thread-live(?!.*running)/",
          "group": "inline@2"
        },
        {
          "command": "turnhuddle.restore",
          "when": "view == turnhuddle.threads && viewItem =~ /^thread-archived/",
          "group": "inline@2"
        },
        {
          "command": "turnhuddle.rename",
          "when": "view == turnhuddle.threads && viewItem =~ /^thread-/",
          "group": "1_edit@1"
        },
        {
          "command": "turnhuddle.toggleBookmark",
          "when": "view == turnhuddle.threads && viewItem =~ /^thread-live/",
          "group": "1_edit@2"
        },
        {
          "command": "turnhuddle.archive",
          "when": "view == turnhuddle.threads && viewItem =~ /^thread-live(?!.*running)/",
          "group": "2_archive@1"
        },
        {
          "command": "turnhuddle.restore",
          "when": "view == turnhuddle.threads && viewItem =~ /^thread-archived/",
          "group": "2_archive@1"
        }
      ],
      "editor/title": [
        {
          "command": "turnhuddle.focus",
          "group": "navigation@90",
          "when": "config.turnhuddle.showEditorButton"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "turnhuddle.threads",
        "contents": "No threads yet.\n[New Thread](command:turnhuddle.newThread)\nYou can also [continue a Claude Code or Codex session](command:turnhuddle.continueFrom)."
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/*.test.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "test:vscode": "node test/vscode/run.cjs",
    "vsce:ls": "vsce ls",
    "site": "npm run compile && node scripts/whats-new.cjs site site",
    "screenshots": "npm run compile && node scripts/screenshots.cjs",
    "check-notes": "node scripts/whats-new.cjs check \"$(node -p \\\"require('./package.json').version\\\")\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^5.7.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.332"
  }
}
