{
  "name": "turnhuddle",
  "displayName": "Turnhuddle",
  "description": "Claude Code and Codex in one chat: Claude proposes, Codex reviews, and they keep going until both agree.",
  "version": "0.2.0",
  "publisher": "turnhuddle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sibinms/turnhuddle.git"
  },
  "homepage": "https://github.com/sibinms/turnhuddle#readme",
  "bugs": {
    "url": "https://github.com/sibinms/turnhuddle/issues"
  },
  "icon": "media/icon.png",
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "claude",
    "codex",
    "ai",
    "agents",
    "code review",
    "chat",
    "pair programming"
  ],
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "turnhuddle.check",
        "title": "Check CLI Installations",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.start",
        "title": "Start Claude \u2194 Codex Conversation",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.reply",
        "title": "Reply in Conversation",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.cancel",
        "title": "Cancel Conversation",
        "category": "Turnhuddle",
        "icon": "$(debug-stop)"
      },
      {
        "command": "turnhuddle.clear",
        "title": "New Conversation",
        "category": "Turnhuddle",
        "icon": "$(add)"
      },
      {
        "command": "turnhuddle.getState",
        "title": "Get Conversation State",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.open",
        "title": "Open Conversation",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.archive",
        "title": "Archive Conversation",
        "category": "Turnhuddle",
        "icon": "$(archive)"
      },
      {
        "command": "turnhuddle.restore",
        "title": "Restore Conversation",
        "category": "Turnhuddle",
        "icon": "$(history)"
      },
      {
        "command": "turnhuddle.revealHistory",
        "title": "Reveal History Folder",
        "category": "Turnhuddle",
        "icon": "$(folder-opened)"
      },
      {
        "command": "turnhuddle.listSessions",
        "title": "List Conversations",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.refreshSessions",
        "title": "Refresh Conversations",
        "category": "Turnhuddle",
        "icon": "$(refresh)"
      },
      {
        "command": "turnhuddle.continueFrom",
        "title": "Continue from a Claude Code or Codex Session",
        "category": "Turnhuddle",
        "icon": "$(debug-continue)"
      },
      {
        "command": "turnhuddle.listVendorSessions",
        "title": "List CLI Sessions",
        "category": "Turnhuddle"
      },
      {
        "command": "turnhuddle.checkForUpdates",
        "title": "Check for Updates",
        "category": "Turnhuddle"
      }
    ],
    "configuration": {
      "title": "Turnhuddle",
      "properties": {
        "turnhuddle.claudePath": {
          "type": "string",
          "default": "claude",
          "scope": "machine",
          "description": "Claude executable path, without arguments."
        },
        "turnhuddle.codexPath": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "description": "Codex executable path, without arguments."
        },
        "turnhuddle.timeoutSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 1,
          "maximum": 1800
        },
        "turnhuddle.maxOutputBytes": {
          "type": "number",
          "default": 1048576,
          "minimum": 1024,
          "maximum": 10485760
        },
        "turnhuddle.claudeEffort": {
          "type": "string",
          "enum": [
            "inherit",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "inherit",
          "description": "Effort level passed to the Claude CLI (--effort). \"inherit\" uses the CLI's own default."
        },
        "turnhuddle.codexReasoningEffort": {
          "type": "string",
          "enum": [
            "inherit",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "ultra"
          ],
          "default": "medium",
          "description": "Reasoning effort for the Codex CLI (model_reasoning_effort) during Turnhuddle turns only. \"inherit\" uses your Codex config; \"ultra\" and \"xhigh\" take the longest."
        },
        "turnhuddle.roundMode": {
          "type": "string",
          "enum": [
            "agreement",
            "fixed"
          ],
          "enumDescriptions": [
            "Claude and Codex alternate until both end a turn with VERDICT: AGREE back to back, or the turn limit is reached.",
            "Three turns per round: Claude proposes, Codex reviews, Claude replies."
          ],
          "default": "agreement",
          "description": "How a round ends."
        },
        "turnhuddle.maxTurnsPerRound": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "maximum": 30,
          "description": "Agreement mode: the most agent turns in one round before it ends without agreement."
        },
        "turnhuddle.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Check GitHub once a day for a newer Turnhuddle release and offer to install it. Installs from the Marketplace are also updated by VS Code itself."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "turnhuddle",
          "title": "Turnhuddle",
          "icon": "media/turnhuddle.svg"
        }
      ]
    },
    "views": {
      "turnhuddle": [
        {
          "id": "turnhuddle.sessions",
          "name": "Conversations",
          "contextualTitle": "Turnhuddle",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "turnhuddle.conversation",
          "name": "Chat",
          "contextualTitle": "Turnhuddle"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "turnhuddle.clear",
          "when": "view == turnhuddle.conversation && !turnhuddle.running",
          "group": "navigation@1"
        },
        {
          "command": "turnhuddle.cancel",
          "when": "view == turnhuddle.conversation && turnhuddle.running",
          "group": "navigation@1"
        },
        {
          "command": "turnhuddle.continueFrom",
          "when": "view == turnhuddle.sessions",
          "group": "navigation@0"
        },
        {
          "command": "turnhuddle.refreshSessions",
          "when": "view == turnhuddle.sessions",
          "group": "navigation@1"
        },
        {
          "command": "turnhuddle.revealHistory",
          "when": "view == turnhuddle.sessions",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "turnhuddle.getState",
          "when": "false"
        },
        {
          "command": "turnhuddle.listSessions",
          "when": "false"
        },
        {
          "command": "turnhuddle.open",
          "when": "false"
        },
        {
          "command": "turnhuddle.archive",
          "when": "false"
        },
        {
          "command": "turnhuddle.restore",
          "when": "false"
        },
        {
          "command": "turnhuddle.refreshSessions",
          "when": "false"
        },
        {
          "command": "turnhuddle.listVendorSessions",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "turnhuddle.archive",
          "when": "view == turnhuddle.sessions && viewItem == turnhuddle.conversation",
          "group": "inline@1"
        },
        {
          "command": "turnhuddle.archive",
          "when": "view == turnhuddle.sessions && viewItem == turnhuddle.conversation",
          "group": "1_modify@1"
        },
        {
          "command": "turnhuddle.restore",
          "when": "view == turnhuddle.sessions && viewItem == turnhuddle.archived",
          "group": "inline@1"
        },
        {
          "command": "turnhuddle.restore",
          "when": "view == turnhuddle.sessions && viewItem == turnhuddle.archived",
          "group": "1_modify@1"
        },
        {
          "command": "turnhuddle.revealHistory",
          "when": "view == turnhuddle.sessions && viewItem == turnhuddle.archivedGroup",
          "group": "inline@1"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "turnhuddle.sessions",
        "contents": "No conversations yet. Type a task in the Chat view below to start one, or\\n[Continue from a Claude Code or Codex session](command:turnhuddle.continueFrom)."
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/*.test.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "test:vscode": "node test/vscode/run.cjs",
    "vsce:ls": "vsce ls",
    "site": "npm run compile && node scripts/whats-new.cjs site site",
    "screenshots": "npm run compile && node scripts/screenshots.cjs",
    "check-notes": "node scripts/whats-new.cjs check \"$(node -p \\\"require('./package.json').version\\\")\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^5.7.0"
  }
}
